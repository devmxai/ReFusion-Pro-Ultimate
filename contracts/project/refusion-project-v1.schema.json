{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refusion.dev/contracts/project/refusion-project-v1.schema.json",
  "title": "ReFusion Project Seed Schema v1",
  "description": "Experimental G1/G2 seed used by the 30-second project-open vertical slice; not yet a stable shipping format.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "composition"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "composition": {"$ref": "#/$defs/composition"}
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{8}$"
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ns", "duration_ns"],
      "properties": {
        "start_ns": {"type": "integer", "minimum": 0},
        "duration_ns": {"type": "integer", "minimum": 1}
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position_x",
        "position_y",
        "scale_x",
        "scale_y",
        "rotation_degrees",
        "opacity"
      ],
      "properties": {
        "position_x": {"type": "number"},
        "position_y": {"type": "number"},
        "scale_x": {"type": "number", "exclusiveMinimum": 0},
        "scale_y": {"type": "number", "exclusiveMinimum": 0},
        "rotation_degrees": {"type": "number"},
        "opacity": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time_ns", "value"],
      "properties": {
        "time_ns": {"type": "integer", "minimum": 0},
        "value": {"type": "number"}
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property", "keyframes"],
      "properties": {
        "property": {
          "enum": [
            "transform.position.x",
            "transform.position.y",
            "transform.scale.x",
            "transform.scale.y",
            "transform.rotation",
            "transform.opacity"
          ]
        },
        "keyframes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/keyframe"}
        }
      }
    },
    "shapeContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "width", "height", "corner_radius", "fill"],
      "properties": {
        "type": {"const": "shape"},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0},
        "corner_radius": {"type": "number", "minimum": 0},
        "fill": {"$ref": "#/$defs/color"}
      }
    },
    "textContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text",
        "font_family",
        "font_size",
        "layout_width",
        "left_to_right",
        "fill"
      ],
      "properties": {
        "type": {"const": "text"},
        "text": {"type": "string", "minLength": 1},
        "font_family": {"type": "string", "minLength": 1},
        "font_size": {"type": "number", "exclusiveMinimum": 0},
        "layout_width": {"type": "number", "exclusiveMinimum": 0},
        "left_to_right": {"type": "boolean"},
        "fill": {"$ref": "#/$defs/color"}
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "active_range",
        "transform",
        "animations",
        "content"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "active_range": {"$ref": "#/$defs/timeRange"},
        "transform": {"$ref": "#/$defs/transform"},
        "animations": {
          "type": "array",
          "items": {"$ref": "#/$defs/animation"}
        },
        "content": {
          "oneOf": [
            {"$ref": "#/$defs/shapeContent"},
            {"$ref": "#/$defs/textContent"}
          ]
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "canvas", "frame_rate", "duration_ns", "layers"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "canvas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width_pixels", "height_pixels"],
          "properties": {
            "width_pixels": {"type": "integer", "minimum": 1},
            "height_pixels": {"type": "integer", "minimum": 1}
          }
        },
        "frame_rate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["numerator", "denominator"],
          "properties": {
            "numerator": {"type": "integer", "minimum": 1},
            "denominator": {"type": "integer", "minimum": 1}
          }
        },
        "duration_ns": {"type": "integer", "minimum": 1},
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/layer"}
        }
      }
    }
  }
}
