{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "REFUSION_STRICT_WARNINGS": "ON"
      }
    },
    {
      "name": "ios-canary-base",
      "hidden": true,
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "18.0",
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED": "NO",
        "BUILD_TESTING": "OFF",
        "REFUSION_BUILD_CLI": "OFF",
        "REFUSION_STRICT_WARNINGS": "ON"
      }
    },
    {
      "name": "android-canary-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "condition": {
        "type": "notEquals",
        "lhs": "$env{ANDROID_NDK_HOME}",
        "rhs": ""
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-28",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY",
        "BUILD_TESTING": "OFF",
        "REFUSION_BUILD_CLI": "OFF",
        "REFUSION_STRICT_WARNINGS": "ON"
      }
    },
    {
      "name": "macos-core",
      "inherits": "base",
      "displayName": "macOS portable core",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-core-sanitized",
      "inherits": "macos-core",
      "displayName": "macOS portable core with ASan and UBSan",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "macos-studio",
      "inherits": "macos-core",
      "displayName": "macOS Qt Studio foundation shell",
      "cacheVariables": {
        "REFUSION_BUILD_STUDIO": "ON"
      }
    },
    {
      "name": "macos-graphics",
      "inherits": "macos-core",
      "displayName": "macOS engine-owned Metal and Skia foundation",
      "cacheVariables": {
        "REFUSION_BUILD_PLATFORM_GPU": "ON",
        "REFUSION_ENABLE_SKIA": "ON",
        "REFUSION_SKIA_PROFILE": "macos-arm64-metal",
        "REFUSION_SKIA_SOURCE_DIR": "${sourceDir}/out/deps-src/skia",
        "REFUSION_SKIA_BUILD_DIR": "${sourceDir}/out/deps-build/skia/macos-arm64-metal"
      }
    },
    {
      "name": "macos-visual",
      "inherits": "macos-core",
      "displayName": "macOS native Qt + Metal + Skia visual runtime",
      "cacheVariables": {
        "REFUSION_BUILD_STUDIO": "ON",
        "REFUSION_BUILD_PLATFORM_GPU": "ON",
        "REFUSION_BUILD_PLATFORM_MEDIA": "ON",
        "REFUSION_ENABLE_SKIA": "ON",
        "REFUSION_SKIA_PROFILE": "macos-arm64-metal",
        "REFUSION_SKIA_SOURCE_DIR": "${sourceDir}/out/deps-src/skia",
        "REFUSION_SKIA_BUILD_DIR": "${sourceDir}/out/deps-build/skia/macos-arm64-metal"
      }
    },
    {
      "name": "macos-media",
      "inherits": "macos-core",
      "displayName": "macOS strict hardware-media capability and native surface proof",
      "cacheVariables": {
        "REFUSION_BUILD_PLATFORM_GPU": "ON",
        "REFUSION_BUILD_PLATFORM_MEDIA": "ON"
      }
    },
    {
      "name": "windows-core",
      "inherits": "base",
      "displayName": "Windows portable core",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-studio",
      "inherits": "windows-core",
      "displayName": "Windows Qt Studio foundation shell",
      "cacheVariables": {
        "REFUSION_BUILD_STUDIO": "ON"
      }
    },
    {
      "name": "windows-graphics",
      "inherits": "windows-core",
      "displayName": "Windows engine-owned D3D12 and Skia foundation",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL",
        "REFUSION_BUILD_PLATFORM_GPU": "ON",
        "REFUSION_ENABLE_SKIA": "ON",
        "REFUSION_SKIA_PROFILE": "windows-x64-d3d12",
        "REFUSION_SKIA_SOURCE_DIR": "${sourceDir}/out/deps-src/skia",
        "REFUSION_SKIA_BUILD_DIR": "${sourceDir}/out/deps-build/skia/windows-x64-d3d12"
      }
    },
    {
      "name": "windows-visual",
      "inherits": "windows-graphics",
      "displayName": "Windows native Qt + D3D12 + Skia visual runtime",
      "cacheVariables": {
        "REFUSION_BUILD_STUDIO": "ON"
      }
    },
    {
      "name": "windows-media",
      "inherits": "windows-core",
      "displayName": "Windows strict hardware-media compile lane",
      "cacheVariables": {
        "REFUSION_BUILD_PLATFORM_GPU": "ON",
        "REFUSION_BUILD_PLATFORM_MEDIA": "ON"
      }
    },
    {
      "name": "ios-core-canary",
      "inherits": "ios-canary-base",
      "displayName": "iOS arm64 portable Core/RFX/RenderPlan contract canary"
    },
    {
      "name": "ios-graphics-canary",
      "inherits": "ios-core-canary",
      "displayName": "iOS arm64 Metal + shared Skia contract canary",
      "cacheVariables": {
        "REFUSION_BUILD_PLATFORM_GPU": "ON",
        "REFUSION_ENABLE_SKIA": "ON",
        "REFUSION_SKIA_PROFILE": "ios-arm64-metal-canary",
        "REFUSION_SKIA_SOURCE_DIR": "${sourceDir}/out/deps-src/skia",
        "REFUSION_SKIA_BUILD_DIR": "${sourceDir}/out/deps-build/skia/ios-arm64-metal-canary"
      }
    },
    {
      "name": "android-core-canary",
      "inherits": "android-canary-base",
      "displayName": "Android arm64-v8a portable Core/RFX/RenderPlan contract canary"
    },
    {
      "name": "android-graphics-canary",
      "inherits": "android-core-canary",
      "displayName": "Android arm64-v8a Vulkan + shared Skia contract canary",
      "cacheVariables": {
        "REFUSION_BUILD_PLATFORM_GPU": "ON",
        "REFUSION_ENABLE_SKIA": "ON",
        "REFUSION_SKIA_PROFILE": "android-arm64-vulkan-canary",
        "REFUSION_SKIA_SOURCE_DIR": "${sourceDir}/out/deps-src/skia",
        "REFUSION_SKIA_BUILD_DIR": "${sourceDir}/out/deps-build/skia/android-arm64-vulkan-canary"
      }
    }
  ],
  "buildPresets": [
    { "name": "macos-core", "configurePreset": "macos-core" },
    { "name": "macos-core-sanitized", "configurePreset": "macos-core-sanitized" },
    { "name": "macos-studio", "configurePreset": "macos-studio" },
    { "name": "macos-graphics", "configurePreset": "macos-graphics" },
    { "name": "macos-visual", "configurePreset": "macos-visual" },
    { "name": "macos-media", "configurePreset": "macos-media" },
    { "name": "windows-core", "configurePreset": "windows-core" },
    { "name": "windows-studio", "configurePreset": "windows-studio" },
    { "name": "windows-graphics", "configurePreset": "windows-graphics" },
    { "name": "windows-visual", "configurePreset": "windows-visual" },
    { "name": "windows-media", "configurePreset": "windows-media" },
    { "name": "ios-core-canary", "configurePreset": "ios-core-canary", "configuration": "Debug" },
    { "name": "ios-graphics-canary", "configurePreset": "ios-graphics-canary", "configuration": "Debug" },
    { "name": "android-core-canary", "configurePreset": "android-core-canary" },
    { "name": "android-graphics-canary", "configurePreset": "android-graphics-canary" }
  ],
  "testPresets": [
    {
      "name": "macos-core",
      "configurePreset": "macos-core",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "macos-core-sanitized",
      "configurePreset": "macos-core-sanitized",
      "output": { "outputOnFailure": true },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "macos-studio",
      "configurePreset": "macos-studio",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "macos-graphics",
      "configurePreset": "macos-graphics",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "macos-visual",
      "configurePreset": "macos-visual",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "macos-media",
      "configurePreset": "macos-media",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-core",
      "configurePreset": "windows-core",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-studio",
      "configurePreset": "windows-studio",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-graphics",
      "configurePreset": "windows-graphics",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-visual",
      "configurePreset": "windows-visual",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-media",
      "configurePreset": "windows-media",
      "output": { "outputOnFailure": true }
    }
  ],
  "workflowPresets": [
    {
      "name": "macos-core",
      "steps": [
        { "type": "configure", "name": "macos-core" },
        { "type": "build", "name": "macos-core" },
        { "type": "test", "name": "macos-core" }
      ]
    },
    {
      "name": "macos-core-sanitized",
      "steps": [
        { "type": "configure", "name": "macos-core-sanitized" },
        { "type": "build", "name": "macos-core-sanitized" },
        { "type": "test", "name": "macos-core-sanitized" }
      ]
    },
    {
      "name": "macos-studio",
      "steps": [
        { "type": "configure", "name": "macos-studio" },
        { "type": "build", "name": "macos-studio" },
        { "type": "test", "name": "macos-studio" }
      ]
    },
    {
      "name": "macos-graphics",
      "steps": [
        { "type": "configure", "name": "macos-graphics" },
        { "type": "build", "name": "macos-graphics" },
        { "type": "test", "name": "macos-graphics" }
      ]
    },
    {
      "name": "macos-visual",
      "steps": [
        { "type": "configure", "name": "macos-visual" },
        { "type": "build", "name": "macos-visual" },
        { "type": "test", "name": "macos-visual" }
      ]
    },
    {
      "name": "macos-media",
      "steps": [
        { "type": "configure", "name": "macos-media" },
        { "type": "build", "name": "macos-media" },
        { "type": "test", "name": "macos-media" }
      ]
    },
    {
      "name": "windows-core",
      "steps": [
        { "type": "configure", "name": "windows-core" },
        { "type": "build", "name": "windows-core" },
        { "type": "test", "name": "windows-core" }
      ]
    },
    {
      "name": "windows-studio",
      "steps": [
        { "type": "configure", "name": "windows-studio" },
        { "type": "build", "name": "windows-studio" },
        { "type": "test", "name": "windows-studio" }
      ]
    },
    {
      "name": "windows-graphics",
      "steps": [
        { "type": "configure", "name": "windows-graphics" },
        { "type": "build", "name": "windows-graphics" },
        { "type": "test", "name": "windows-graphics" }
      ]
    },
    {
      "name": "windows-visual",
      "steps": [
        { "type": "configure", "name": "windows-visual" },
        { "type": "build", "name": "windows-visual" },
        { "type": "test", "name": "windows-visual" }
      ]
    },
    {
      "name": "windows-media",
      "steps": [
        { "type": "configure", "name": "windows-media" },
        { "type": "build", "name": "windows-media" },
        { "type": "test", "name": "windows-media" }
      ]
    },
    {
      "name": "ios-core-canary",
      "steps": [
        { "type": "configure", "name": "ios-core-canary" },
        { "type": "build", "name": "ios-core-canary" }
      ]
    },
    {
      "name": "ios-graphics-canary",
      "steps": [
        { "type": "configure", "name": "ios-graphics-canary" },
        { "type": "build", "name": "ios-graphics-canary" }
      ]
    },
    {
      "name": "android-core-canary",
      "steps": [
        { "type": "configure", "name": "android-core-canary" },
        { "type": "build", "name": "android-core-canary" }
      ]
    },
    {
      "name": "android-graphics-canary",
      "steps": [
        { "type": "configure", "name": "android-graphics-canary" },
        { "type": "build", "name": "android-graphics-canary" }
