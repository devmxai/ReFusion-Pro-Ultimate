{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "REFUSION_STRICT_WARNINGS": "ON"
      }
    },
    {
      "name": "macos-core",
      "inherits": "base",
      "displayName": "macOS portable core",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-core-sanitized",
      "inherits": "macos-core",
      "displayName": "macOS portable core with ASan and UBSan",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "macos-studio",
      "inherits": "macos-core",
      "displayName": "macOS Qt Studio foundation shell",
      "cacheVariables": {
        "REFUSION_BUILD_STUDIO": "ON"
      }
    },
    {
      "name": "macos-graphics",
      "inherits": "macos-core",
      "displayName": "macOS engine-owned Metal and Skia foundation",
      "cacheVariables": {
        "REFUSION_BUILD_PLATFORM_GPU": "ON",
        "REFUSION_ENABLE_SKIA": "ON",
        "REFUSION_SKIA_SOURCE_DIR": "${sourceDir}/out/deps-src/skia",
        "REFUSION_SKIA_BUILD_DIR": "${sourceDir}/out/deps-build/skia/macos-arm64-metal"
      }
    },
    {
      "name": "macos-visual",
      "inherits": "macos-core",
      "displayName": "macOS native Qt + Metal + Skia visual runtime",
      "cacheVariables": {
        "REFUSION_BUILD_STUDIO": "ON",
        "REFUSION_BUILD_PLATFORM_GPU": "ON",
        "REFUSION_ENABLE_SKIA": "ON",
        "REFUSION_SKIA_SOURCE_DIR": "${sourceDir}/out/deps-src/skia",
        "REFUSION_SKIA_BUILD_DIR": "${sourceDir}/out/deps-build/skia/macos-arm64-metal"
      }
    },
    {
      "name": "macos-media",
      "inherits": "macos-core",
      "displayName": "macOS strict hardware-media capability and native surface proof",
      "cacheVariables": {
        "REFUSION_BUILD_PLATFORM_GPU": "ON",
        "REFUSION_BUILD_PLATFORM_MEDIA": "ON"
      }
    },
    {
      "name": "windows-core",
      "inherits": "base",
      "displayName": "Windows portable core",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-studio",
      "inherits": "windows-core",
      "displayName": "Windows Qt Studio foundation shell",
      "cacheVariables": {
        "REFUSION_BUILD_STUDIO": "ON"
      }
    },
    {
      "name": "windows-graphics",
      "inherits": "windows-core",
      "displayName": "Windows engine-owned D3D12 and Skia foundation",
      "cacheVariables": {
        "REFUSION_BUILD_PLATFORM_GPU": "ON",
        "REFUSION_ENABLE_SKIA": "ON",
        "REFUSION_SKIA_SOURCE_DIR": "${sourceDir}/out/deps-src/skia",
        "REFUSION_SKIA_BUILD_DIR": "${sourceDir}/out/deps-build/skia/windows-x64-d3d12"
      }
    },
    {
      "name": "windows-media",
      "inherits": "windows-core",
      "displayName": "Windows strict hardware-media compile lane",
      "cacheVariables": {
        "REFUSION_BUILD_PLATFORM_GPU": "ON",
        "REFUSION_BUILD_PLATFORM_MEDIA": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "macos-core", "configurePreset": "macos-core" },
    { "name": "macos-core-sanitized", "configurePreset": "macos-core-sanitized" },
    { "name": "macos-studio", "configurePreset": "macos-studio" },
    { "name": "macos-graphics", "configurePreset": "macos-graphics" },
    { "name": "macos-visual", "configurePreset": "macos-visual" },
    { "name": "macos-media", "configurePreset": "macos-media" },
    { "name": "windows-core", "configurePreset": "windows-core" },
    { "name": "windows-studio", "configurePreset": "windows-studio" },
    { "name": "windows-graphics", "configurePreset": "windows-graphics" },
    { "name": "windows-media", "configurePreset": "windows-media" }
  ],
  "testPresets": [
    {
      "name": "macos-core",
      "configurePreset": "macos-core",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "macos-core-sanitized",
      "configurePreset": "macos-core-sanitized",
      "output": { "outputOnFailure": true },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "macos-studio",
      "configurePreset": "macos-studio",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "macos-graphics",
      "configurePreset": "macos-graphics",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "macos-visual",
      "configurePreset": "macos-visual",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "macos-media",
      "configurePreset": "macos-media",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-core",
      "configurePreset": "windows-core",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-studio",
      "configurePreset": "windows-studio",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-graphics",
      "configurePreset": "windows-graphics",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-media",
      "configurePreset": "windows-media",
      "output": { "outputOnFailure": true }
    }
  ],
  "workflowPresets": [
    {
      "name": "macos-core",
      "steps": [
        { "type": "configure", "name": "macos-core" },
        { "type": "build", "name": "macos-core" },
        { "type": "test", "name": "macos-core" }
      ]
    },
    {
      "name": "macos-core-sanitized",
      "steps": [
        { "type": "configure", "name": "macos-core-sanitized" },
        { "type": "build", "name": "macos-core-sanitized" },
        { "type": "test", "name": "macos-core-sanitized" }
      ]
    },
    {
      "name": "macos-studio",
      "steps": [
        { "type": "configure", "name": "macos-studio" },
        { "type": "build", "name": "macos-studio" },
        { "type": "test", "name": "macos-studio" }
      ]
    },
    {
      "name": "macos-graphics",
      "steps": [
        { "type": "configure", "name": "macos-graphics" },
        { "type": "build", "name": "macos-graphics" },
        { "type": "test", "name": "macos-graphics" }
      ]
    },
    {
      "name": "macos-visual",
      "steps": [
        { "type": "configure", "name": "macos-visual" },
        { "type": "build", "name": "macos-visual" },
        { "type": "test", "name": "macos-visual" }
      ]
    },
    {
      "name": "macos-media",
      "steps": [
        { "type": "configure", "name": "macos-media" },
        { "type": "build", "name": "macos-media" },
        { "type": "test", "name": "macos-media" }
      ]
    },
    {
      "name": "windows-core",
      "steps": [
        { "type": "configure", "name": "windows-core" },
        { "type": "build", "name": "windows-core" },
        { "type": "test", "name": "windows-core" }
      ]
    },
    {
      "name": "windows-studio",
      "steps": [
        { "type": "configure", "name": "windows-studio" },
        { "type": "build", "name": "windows-studio" },
        { "type": "test", "name": "windows-studio" }
      ]
    },
    {
      "name": "windows-graphics",
      "steps": [
        { "type": "configure", "name": "windows-graphics" },
        { "type": "build", "name": "windows-graphics" },
        { "type": "test", "name": "windows-graphics" }
      ]
    },
    {
      "name": "windows-media",
      "steps": [
        { "type": "configure", "name": "windows-media" },
        { "type": "build", "name": "windows-media" },
        { "type": "test", "name": "windows-media" }
      ]
    }
  ]
}
