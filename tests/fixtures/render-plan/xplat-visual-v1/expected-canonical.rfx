rfx 5;
registry digest("rfx-vp-fnv1a64:f6f8d1b88fe2d101");
contributions digest("rfx-vc-fnv1a64:67e38c18c14ab42b");

project id("prj_xplat_visual_v1") revision(12)
  name("Cross Platform Visual Conformance V1");

composition id("cmp_xplat_visual_v1") name("Visual Conformance") {
  canvas px(640, 360);
  frame_rate rational(60, 1);
  duration frames(120);

  layer shape id("lyr_solid_normal") name("Solid Normal") {
    range frames(0, 120);
    transform {
      position parent_px(320, 180);
      anchor local_px(0, 0);
      scale ratio(1, 1);
      rotation degrees(0);
      opacity ratio(1);
    }
    blend(normal);
    content shape {
      size px(640, 360);
      corner_radius px(0);
      fill rgba8("#0A1020FF");
      stroke width px(0) color rgba8("#000000FF");
    }
  }

  layer shape id("lyr_linear_multiply") name("Linear Multiply") {
    range frames(0, 120);
    transform {
      position parent_px(205, 150);
      anchor local_px(0, 0);
      scale ratio(1, 1);
      rotation degrees(-8);
      opacity ratio(0.88);
    }
    blend(multiply);
    content shape {
      size px(250, 150);
      corner_radius px(28);
      fill linear_gradient {
        start local_px(-125, -75);
        end local_px(125, 75);
        stop ratio(0) color rgba8("#FF3E58FF");
        stop ratio(0.40000000000000002) color rgba8("#8D5CFFE0");
        stop ratio(1) color rgba8("#20D0FFFF");
      };
      stroke width px(3) color rgba8("#FFFFFFA0");
    }
    mask rounded_rect id("mask_linear") enabled(true) inverted(false) {
      parameter position_x number(0);
      parameter position_y number(0);
      parameter width number(230);
      parameter height number(130);
      parameter corner_radius number(22);
    }
    effect gaussian_blur id("fx_linear_blur") enabled(true) {
      parameter sigma_x number(2);
      parameter sigma_y number(3);
    }
    effect drop_shadow id("fx_linear_shadow") enabled(true) {
      parameter offset_x number(7);
      parameter offset_y number(10);
      parameter sigma_x number(5);
      parameter sigma_y number(6);
      parameter color color_rgba8("#000000A0");
    }
    effect glow id("fx_linear_glow") enabled(true) {
      parameter sigma number(9);
      parameter color color_rgba8("#8D5CFFB0");
    }
    animate transform.position.x {
      key frame(0) value(205);
      key frame(60) value(230);
      key frame(120) value(205);
    }
  }

  layer shape id("lyr_radial_screen") name("Radial Screen") {
    range frames(0, 120);
    transform {
      position parent_px(430, 205);
      anchor local_px(0, 0);
      scale ratio(1, 1);
      rotation degrees(0);
      opacity ratio(0.76000000000000001);
    }
    blend(screen);
    content shape {
      size px(180, 180);
      corner_radius px(90);
      fill radial_gradient {
        center local_px(0, 0);
        radius px(90);
        stop ratio(0) color rgba8("#FFFFFFFF");
        stop ratio(0.5) color rgba8("#20D0FFC0");
        stop ratio(1) color rgba8("#07142D00");
      };
      stroke width px(1) color rgba8("#20D0FFFF");
    }
    mask rounded_rect id("mask_radial_inverted") enabled(true) inverted(true) {
      parameter position_x number(20);
      parameter position_y number(0);
      parameter width number(54);
      parameter height number(140);
      parameter corner_radius number(27);
    }
    effect drop_shadow id("fx_radial_shadow") enabled(true) {
      parameter offset_x number(-6);
      parameter offset_y number(8);
      parameter sigma_x number(7);
      parameter sigma_y number(7);
      parameter color color_rgba8("#10204090");
    }
    animate transform.rotation {
      key frame(0) value(0);
      key frame(60) value(24);
      key frame(120) value(0);
    }
  }

  layer text id("lyr_text_overlay") name("Text Overlay") {
    range frames(0, 120);
    transform {
      position parent_px(320, 72);
      anchor local_px(0, 0);
      scale ratio(1, 1);
      rotation degrees(0);
      opacity ratio(1);
    }
    blend(overlay);
    content text {
      value("ReFusion · اختبار");
      font packaged_asset id("font_noto_sans_arabic_regular") family("Noto Sans Arabic") digest("sha256:7ed3fe069312aceac454f17cf613a30f95271d6ed7ce58005ed4d016bd3823d7");
      font_size local_px(42);
      box local_px(520, 72) padding local_px(4, 8, 4, 8);
      direction(rtl);
      horizontal_align(center);
      vertical_align(center);
      wrap(no_wrap);
      overflow(clip);
      line_height ratio(1.1000000000000001);
      letter_spacing local_px(0);
      fill rgba8("#FFFFFFFF");
    }
    effect glow id("fx_text_glow") enabled(true) {
      parameter sigma number(6);
      parameter color color_rgba8("#20D0FFC0");
    }
  }

  group id("grp_shapes") name("Shapes") {
    range frames(0, 120);
    transform {
      position parent_px(320, 180);
      anchor local_px(320, 180);
      scale ratio(1, 1);
      rotation degrees(0);
      opacity ratio(1);
    }
    children {
      layer("lyr_linear_multiply");
      layer("lyr_radial_screen");
    }
    animate transform.scale.x {
      key frame(0) value(0.95999999999999996);
      key frame(60) value(1.04);
      key frame(120) value(0.95999999999999996);
    }
    animate transform.scale.y {
      key frame(0) value(0.95999999999999996);
      key frame(60) value(1.04);
      key frame(120) value(0.95999999999999996);
    }
  }

  root {
    layer("lyr_solid_normal");
    group("grp_shapes");
    layer("lyr_text_overlay");
  }
}
